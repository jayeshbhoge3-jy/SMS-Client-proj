# ==============================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to '.env' and replace dummy values with your real credentials.
# NEVER commit your real '.env' file to GitHub!
# ==============================================================================

# Django Core Settings
SECRET_KEY=your-secret-key-here-generate-a-secure-one
DEBUG=False
ALLOWED_HOSTS=127.0.0.1,localhost,.onrender.com,.koyeb.app
SITE_URL=http://127.0.0.1:8000
CSRF_TRUSTED_ORIGINS=https://your-service.onrender.com,http://127.0.0.1:8000

# Production Cloud Database (Recommended: Free PostgreSQL from Neon.tech or Supabase)
# If DATABASE_URL is set, it overrides the individual DB_* fields below.
# DATABASE_URL=postgresql://user:password@ep-xyz.region.neon.tech/neondb?sslmode=require

# Local Database Configuration (Used when DATABASE_URL is not set)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=SMSDB_V6
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432

# Email Settings (Gmail SMTP or Microsoft 365)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_google_app_password
DEFAULT_FROM_EMAIL=your_email@gmail.com

# Razorpay Payment Gateway Credentials
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Celery & Background Task Settings
# Note: With CELERY_TASK_ALWAYS_EAGER=True, tasks run in-process without requiring a separate Redis server!
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=True
